{
  "name": "traycer-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "pnpm --filter @traycer/web lint && eslint apps/api/src apps/workers/src packages/repo-indexer/src packages/orchestrator/src packages/queue/src tests --ext .ts --max-warnings=0",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "type-check": "turbo run type-check",
    "validate:orchestration": "tsx tests/validate-orchestration.ts",
    "verify": "pnpm lint && pnpm type-check && pnpm test:unit && pnpm test:integration && pnpm validate:orchestration",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.19.18",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.0"
  }
}
